PORT=3000
MONGODB_URI=process.env.MONGODB_URI
DB_NAME=process.env.DB_NAME
ALLOWED_DOMAIN=process.env.ALLOWED_DOMAIN

# מחרוזת אקראית ארוכה (לפחות 32 תווים). ליצירה: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=process.env.JWT_SECRET

# מי רשאי לפנות לשרת מהדפדפן. בפיתוח: *    | בייצור: כתובת האתר שלכם, מופרדות בפסיק
# קובץ שנפתח ישירות מהמחשב (file://) שולח Origin בשם null, אז אפשר להוסיף: null
CORS_ORIGIN=process.env.CORS_ORIGIN

# שליחת מייל (SMTP). בלי זה הקוד יודפס רק בחלון השרת.
SMTP_HOST=process.env.SMTP_HOST
SMTP_PORT=process.env.SMTP_PORT
SMTP_USER=process.env.SMTP_USER
SMTP_PASS=process.env.SMTP_PASS
SMTP_FROM=process.env.SMTP_FROM

# לפיתוח בלבד: מחזיר את הקוד גם לדפדפן (מתעלם ממנו כש-NODE_ENV=production)
DEV_RETURN_CODE=process.env.DEV_RETURN_CODE
# NODE_ENV=production
# TRUST_PROXY=true    # אם השרת מאחורי Render/Nginx וכד'
# Groq is called from the server; store the real key as a secret in Render, never in GitHub.
GROQ_API_KEY=process.env.GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
